# Run python3 scripts/setup.py to generate a private local .env. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=sqlite:///../.data/leaklens.db
DATA_DIR=../.data
LOCAL_REPO_ROOT=../.data/repos
JOB_MODE=local
REDIS_URL=redis://localhost:6379/0
FINGERPRINT_KEY=
POSTGRES_PASSWORD=
ALLOWED_ORIGIN=http://localhost:5173
# Compose uses its own canonical loopback origin.
COMPOSE_ORIGIN=http://127.0.0.1:8080
COOKIE_SECURE=false
SESSION_HOURS=12
RAW_RETENTION_HOURS=24
MAX_FILE_BYTES=10485760
MAX_DOCUMENTS=100
MAX_PDF_PAGES=50
MAX_CSV_ROWS=10000
MAX_TEXT_CHARS=200000
MAX_HISTORY_COMMITS=20
HTTP_RATE_SECONDS=0.2
# Live calls are opt-in and billed by your provider; credentials stay on the server.
LLM_MODE=offline
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
AGENT_MAX_TOOLS=6
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_INPUT_TOKENS=18000
AGENT_MAX_OUTPUT_TOKENS=3000
AGENT_MAX_COST_USD=0.25
# Set both prices to enforce a conservative USD ceiling; verify current model pricing.
# INPUT_PRICE_PER_MILLION=
# OUTPUT_PRICE_PER_MILLION=
PUBLIC_READ_ONLY=false
# Exact HTTP origin only; tests/development only, prohibited in production.
FIXTURE_ORIGIN=
# Production Compose only:
# DOMAIN=leaklens.example.com
